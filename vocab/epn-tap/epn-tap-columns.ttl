    rdfs:range xsd:string ;
    pdssp:omsConcept sosa-oms:metadata ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:release_date a rdf:Property ;
