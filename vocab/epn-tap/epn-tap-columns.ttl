    rdfs:range xsd:double ;
    pdssp:unit "deg" ;
    pdssp:omsConcept sosa-oms:parameter ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:phase_max a rdf:Property ;
    rdfs:label "phase_max" ;
    rdfs:range xsd:double ;
    pdssp:unit "deg" ;
    pdssp:omsConcept sosa-oms:parameter ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:instrument_host_name a rdf:Property ;
