@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pdssp: <https://pdssp.github.io/pdssp-ontology/vocab#> .
@prefix uat: <http://astrothesaurus.org/uat/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# PDSSP Platform
# ==============
# The spacecraft carrying the instruments (STAC platform, EPN-TAP
# instrument_host_name; OMS host). Seeded from the ODE STAC collections
# (2026-10-18), where the same spacecraft is written three ways:
# "MARS RECONNAISSANCE ORBITER (MRO)" (Item platform and mission),
# "MARS RECONNAISSANCE ORBITER" (Collection summaries) and "MRO"
# (pds:platform_id). All are altLabels of one concept, so the normaliser
# maps them to the prefLabel.
#
# - prefLabel: the Wikidata English label.
# - pdssp:naifId: NAIF spacecraft ID (mission frames kernel).
# - pdssp:cosparId: COSPAR international designator.
# - skos:exactMatch: Wikidata and the PDS4 instrument_host context product.

pdssp:cosparId a rdf:Property ;
    rdfs:label "COSPAR ID"@en ;
    rdfs:comment "COSPAR international designator (launch year, launch number, piece), e.g. 2005-029A."@en ;
    rdfs:range xsd:string .

pdssp:PlatformScheme a skos:ConceptScheme ;
    dct:title "PDSSP Platform"@en ;
    dct:source <https://naif.jpl.nasa.gov/pub/naif/MRO/kernels/fk/mro_v17.tf> , <https://naif.jpl.nasa.gov/pub/naif/toolkit_docs/C/req/naif_ids.html> , <https://www.wikidata.org/> , <https://pds.mcp.nasa.gov/api/search/1/products> , <https://github.com/astrothesaurus/UAT/releases/tag/v6.0.0> , <https://odestac.staging.stacplanet.pdssp.eu/collections> ;
    skos:definition "The spacecraft (or other platform) hosting the instruments that made an observation."@en ;
    skos:hasTopConcept pdssp:Platform-MRO .

pdssp:Platform-MRO a skos:Concept ; skos:inScheme pdssp:PlatformScheme ; skos:topConceptOf pdssp:PlatformScheme ;
    skos:prefLabel "Mars Reconnaissance Orbiter"@en ;
    skos:altLabel "MRO"@en , "MARS RECONNAISSANCE ORBITER (MRO)" , "MARS RECON ORBITER" ;
    skos:definition "NASA Mars orbiter launched in 2005, in Mars orbit since March 2006."@en ;
    pdssp:naifId -74 ;
    pdssp:cosparId "2005-029A" ;
    skos:exactMatch wd:Q183160 , <urn:nasa:pds:context:instrument_host:spacecraft.mro> ;
    skos:broadMatch uat:1545 .
