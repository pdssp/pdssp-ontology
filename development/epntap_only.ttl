    rdfs:label "release_date" ;
    schema1:name "release_date" ;
    pdssp:adqlName "release_date" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:mappedFrom pdssp:StacProperty_properties_published ;
