<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#s_region> a pdssp:EpnTapColumn ;
    rdfs:label "s_region" ;
    schema1:name "s_region" ;
    rdfs:comment "Footprint, used for CONTAINS()/INTERSECTS() spatial predicates." ;
    pdssp:adqlName "s_region" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:geometryDerived true ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_geometry ;
    pdssp:ucd "pos.outline;obs.field" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#service_title> a pdssp:EpnTapColumn ;
    rdfs:label "service_title" ;
    schema1:name "service_title" ;
    rdfs:comment "Title of resource = schema name (EPN-TAP2 mandatory, fixed value -- keep this in sync with service.title in config.yaml)." ;
    pdssp:adqlName "service_title" ;
    pdssp:arraysize "*" ;
    pdssp:constantValue "EPN-TAP to STAC Planet proxy" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:ucd "meta.title" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#spatial_coordinate_description> a pdssp:EpnTapColumn ;
    rdfs:label "spatial_coordinate_description" ;
    schema1:name "spatial_coordinate_description" ;
    rdfs:comment "IAU CRS name/code." ;
    pdssp:adqlName "spatial_coordinate_description" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_proj_code ;
    pdssp:ucd "meta.code.class;pos.frame" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#spatial_frame_type> a pdssp:EpnTapColumn ;
    rdfs:label "spatial_frame_type" ;
    schema1:name "spatial_frame_type" ;
    rdfs:comment "Always \"body\" for this proxy -- a fixed value, not read from STAC." ;
    pdssp:adqlName "spatial_frame_type" ;
    pdssp:arraysize "*" ;
    pdssp:constantValue "body" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:ucd "pos.frame" .

