@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontology-level metadata for the "thesaurus" named graph
# (https://pdssp.github.io/pdssp-ontology/thesaurus). Without a resource
# declared `a owl:Ontology` here, Widoco's `-getOntologyMetadata` has
# nothing to read and falls back to its own unfilled placeholders
# ([Ontology URI], "license name goes here", empty
# abstract/introduction/description sections) -- exactly what
# https://pdssp.github.io/pdssp-ontology/thesaurus/index-en.html showed
# before this file existed. skos:ConceptScheme resources (in the other
# files of this directory) are a separate concern: each describes ONE
# scheme (product type, method, processing level); this describes the
# thesaurus as a whole, the unit Widoco documents and WebVOWL visualizes.
<https://pdssp.github.io/pdssp-ontology/thesaurus> a owl:Ontology ;
    dct:title "PDSSP Thesaurus"@en ;
    dct:description "A SKOS thesaurus of controlled vocabularies for planetary science data products, published by the Planetary Data and Services System Platform (PDSSP). It defines eleven concept schemes -- product type, acquisition/processing method and processing level (reusing the USGS Thesaurus where it fits, extending it where it doesn't, e.g. anaglyph, point cloud, photogrammetry, stereoscopic imaging), target and target class (aligned with NAIF, Wikidata and the PADC EPN target-class vocabulary), platform, instrument and mission (aligned with NAIF, Wikidata and PDS4 context products), spectral band (instrument channels, aligned with the IVOA messenger vocabulary) coordinate reference system (the IAU 2015 CRS of the OGC registry) and wavelength type (the IVOA messenger terms). It is consumed by PDSSP's own STAC catalogues (`product:type`, `processing:level`, `pdssp:method`, `ssys:targets`, `ssys:target_class`, `platform`, `instruments`, `mission`, `bands`, `proj:code`, `pdssp:wavelength_type`) so that every mission's metadata draws its values from one shared, dereferenceable vocabulary instead of each mission inventing its own labels."@en ;
    dct:abstract "PDSSP's controlled vocabulary for planetary science data products: product type, acquisition/processing method, processing level, target, target class, platform, instrument, mission, spectral band, coordinate reference system and wavelength type."@en ;
    dct:creator "Jean-Christophe Malapert (CNES)" ;
    dct:publisher "PDSSP" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    # No owl:versionIRI yet: 1.0.0 has not been released -- a versioned
    # IRI would wrongly imply a tagged version already exists. Add it
    # (e.g. ".../thesaurus/1.0.0") the day 1.0.0 actually ships, alongside
    # bumping owl:versionInfo below.
    owl:versionInfo "unreleased" ;
    dct:created "2026-09-29"^^xsd:date ;
    dct:modified "2026-10-18"^^xsd:date ;
    vann:preferredNamespacePrefix "pdssp" ;
    vann:preferredNamespaceUri "https://pdssp.github.io/pdssp-ontology/vocab#" .
