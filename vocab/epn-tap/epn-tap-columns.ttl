    rdfs:range xsd:string ;
    pdssp:omsConcept sosa:observedProperty ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:processing_level a rdf:Property ;
    rdfs:label "processing_level" ;
