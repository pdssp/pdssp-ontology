<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#incidence_min> a pdssp:EpnTapColumn ;
    rdfs:label "incidence_min" ;
    schema1:name "incidence_min" ;
    rdfs:comment "Incidence angle (single value in this catalog, reused for min and max)." ;
    pdssp:adqlName "incidence_min" ;
    pdssp:datatype "double" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_view_incidence_angle ;
    pdssp:ucd "pos.incidenceAng;stat.min" ;
    pdssp:unit "deg" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#instrument_host_name> a pdssp:EpnTapColumn ;
    rdfs:label "instrument_host_name" ;
