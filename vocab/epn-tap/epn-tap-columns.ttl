epn:c2max a rdf:Property ;
    rdfs:label "c2max" ;
    rdfs:comment "Max of second coordinate (body frame: latitude)."@en ;
    rdfs:range xsd:double ;
    pdssp:unit "deg" ;
    pdssp:omsConcept sosa:hasFeatureOfInterest ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:c3min a rdf:Property ;
    rdfs:label "c3min" ;
    rdfs:range xsd:double ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:c3max a rdf:Property ;
    rdfs:label "c3max" ;
    rdfs:range xsd:double ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:s_region a rdf:Property ;
    rdfs:label "s_region" ;
    rdfs:comment "Footprint of the granule."@en ;
    rdfs:range xsd:string ;
    pdssp:omsConcept sosa:hasFeatureOfInterest ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:c1_resol_min a rdf:Property ;
    rdfs:label "c1_resol_min" ;
    rdfs:range xsd:double ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:c1_resol_max a rdf:Property ;
