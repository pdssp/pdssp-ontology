    rdfs:comment "Name of the collection's \"host\" provider." ;
    pdssp:adqlName "publisher" ;
    pdssp:arraysize "*" ;
    pdssp:collectionScoped true ;
    pdssp:datatype "char" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_providers_role_host_name ;
    pdssp:ucd "meta.curation" .

