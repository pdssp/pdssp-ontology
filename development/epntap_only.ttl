<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#granule_uid> a pdssp:EpnTapColumn ;
    rdfs:label "granule_uid" ;
    schema1:name "granule_uid" ;
    rdfs:comment "STAC item identifier." ;
    pdssp:adqlName "granule_uid" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:mappedFrom pdssp:StacProperty_id ;
    pdssp:ucd "meta.id" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#incidence_max> a pdssp:EpnTapColumn ;
    rdfs:label "incidence_max" ;
    schema1:name "incidence_max" ;
    pdssp:adqlName "incidence_max" ;
    pdssp:datatype "double" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_view_incidence_angle ;
    pdssp:ucd "pos.incidenceAng;stat.max" ;
