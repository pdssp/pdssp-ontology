    rdfs:range xsd:string ;
    pdssp:omsConcept sosa:hasResult ;
    pdssp:epnMandatory false ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:bib_reference a rdf:Property ;
    rdfs:label "bib_reference" ;
    rdfs:comment "Bibcode, DOI or other bibliographic identifier."@en ;
    rdfs:range xsd:string ;
    pdssp:omsConcept omsa:citation ;
    pdssp:epnMandatory false ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:solar_longitude_min a rdf:Property ;
