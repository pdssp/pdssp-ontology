@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pdssp: <https://pdssp.github.io/pdssp_data_model/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pdssp:adqlName a owl:DatatypeProperty ;
    rdfs:label "adqlName" ;
    schema1:name "adqlName" ;
    rdfs:comment "The ADQL/EPN-TAP column name." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:string .

pdssp:arraysize a owl:DatatypeProperty ;
    rdfs:label "arraysize" ;
    schema1:name "arraysize" ;
    rdfs:comment "VOTable arraysize (e.g. '*' for a variable-length string)." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:string .

pdssp:collectionScoped a owl:DatatypeProperty ;
    rdfs:label "collectionScoped" ;
    schema1:name "collectionScoped" ;
    rdfs:comment "True if mappedFrom points into the STAC Collection rather than the Item." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:boolean .

pdssp:constantValue a owl:DatatypeProperty ;
    rdfs:label "constantValue" ;
    schema1:name "constantValue" ;
    rdfs:comment "The fixed value of a column with no real STAC equivalent." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:string .

pdssp:datatype a owl:DatatypeProperty ;
    rdfs:label "datatype" ;
    schema1:name "datatype" ;
    rdfs:comment "VOTable datatype (char, double, ...)." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:string .

pdssp:fromStacConverter a owl:ObjectProperty ;
    rdfs:label "fromStacConverter" ;
    schema1:name "fromStacConverter" ;
    rdfs:comment "Converter applied to a STAC value before it is reported as this EPN-TAP column." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range pdssp:Converter .

pdssp:geometryDerived a owl:DatatypeProperty ;
    rdfs:label "geometryDerived" ;
    schema1:name "geometryDerived" ;
    rdfs:comment "True for a column computed from the item's GeoJSON geometry." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:boolean .

pdssp:mandatory a owl:DatatypeProperty ;
    rdfs:label "mandatory" ;
    schema1:name "mandatory" ;
    rdfs:comment "True for one of EPN-TAP2's ten always-non-null columns." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:boolean .

pdssp:mappedFrom a owl:ObjectProperty ;
    rdfs:label "mappedFrom" ;
    schema1:name "mappedFrom" ;
    rdfs:comment "The STAC (or STAC Collection) path this column's value comes from." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range pdssp:StacProperty .

pdssp:toStacConverter a owl:ObjectProperty ;
    rdfs:label "toStacConverter" ;
    schema1:name "toStacConverter" ;
    rdfs:comment "Converter applied to an EPN-TAP/ADQL literal before it reaches STAC (e.g. in a CQL2 filter)." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range pdssp:Converter .

pdssp:ucd a owl:DatatypeProperty ;
    rdfs:label "ucd" ;
    schema1:name "ucd" ;
    rdfs:comment "IVOA Unified Content Descriptor for this column." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:string .

pdssp:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    schema1:name "unit" ;
    rdfs:comment "VOTable unit for this column's values." ;
    rdfs:domain pdssp:EpnTapColumn ;
    rdfs:range xsd:string .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary> a owl:Ontology ;
    dcterms:source "https://ivoa.net/documents/EPNTAP/" ;
    dcterms:title "EPN-TAP <-> STAC mapping" ;
    schema1:name "EPN-TAP <-> STAC mapping" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#access_format> a pdssp:EpnTapColumn ;
    rdfs:label "access_format" ;
    schema1:name "access_format" ;
    pdssp:adqlName "access_format" ;
    pdssp:arraysize "*" ;
    pdssp:constantValue "application/x-votable+xml" ;
    pdssp:datatype "char" ;
    pdssp:mandatory false ;
    pdssp:ucd "meta.code.mime" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#access_url> a pdssp:EpnTapColumn ;
    rdfs:label "access_url" ;
    schema1:name "access_url" ;
    rdfs:comment "The URL to get the DataLink for the item." ;
    pdssp:adqlName "access_url" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:fromStacConverter pdssp:Converter_get_datalink_url_for_item ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_root ;
    pdssp:ucd "meta.ref.url" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#bib_reference> a pdssp:EpnTapColumn ;
    rdfs:label "bib_reference" ;
    schema1:name "bib_reference" ;
    pdssp:adqlName "bib_reference" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_sci_doi ;
    pdssp:ucd "meta.bib.doi" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#c1_resol> a pdssp:EpnTapColumn ;
    rdfs:label "c1_resol" ;
    schema1:name "c1_resol" ;
    rdfs:comment "Ground sample distance (same source as c2_resol)." ;
    pdssp:adqlName "c1_resol" ;
    pdssp:datatype "double" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_gsd ;
    pdssp:ucd "pos.resolution" ;
    pdssp:unit "m" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#c1max> a pdssp:EpnTapColumn ;
    rdfs:label "c1max" ;
    schema1:name "c1max" ;
    rdfs:comment "Maximum longitude of the footprint." ;
    pdssp:adqlName "c1max" ;
    pdssp:datatype "double" ;
    pdssp:fromStacConverter pdssp:Converter_geometry_lon_max ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_geometry ;
    pdssp:ucd "pos.bodyrc.lon;stat.max" ;
    pdssp:unit "deg" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#c1min> a pdssp:EpnTapColumn ;
    rdfs:label "c1min" ;
    schema1:name "c1min" ;
    rdfs:comment "Minimum longitude of the footprint. UCD per EPN-TAP2 table 2 for spatial_frame_type=body." ;
    pdssp:adqlName "c1min" ;
    pdssp:datatype "double" ;
    pdssp:fromStacConverter pdssp:Converter_geometry_lon_min ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_geometry ;
    pdssp:ucd "pos.bodyrc.lon;stat.min" ;
    pdssp:unit "deg" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#c2_resol> a pdssp:EpnTapColumn ;
    rdfs:label "c2_resol" ;
    schema1:name "c2_resol" ;
    rdfs:comment "Ground sample distance (same source as c1_resol)." ;
    pdssp:adqlName "c2_resol" ;
    pdssp:datatype "double" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_gsd ;
    pdssp:ucd "pos.resolution" ;
    pdssp:unit "m" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#c2max> a pdssp:EpnTapColumn ;
    rdfs:label "c2max" ;
    schema1:name "c2max" ;
    rdfs:comment "Maximum latitude of the footprint." ;
    pdssp:adqlName "c2max" ;
    pdssp:datatype "double" ;
    pdssp:fromStacConverter pdssp:Converter_geometry_lat_max ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_geometry ;
    pdssp:ucd "pos.bodyrc.lat;stat.max" ;
    pdssp:unit "deg" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#c2min> a pdssp:EpnTapColumn ;
    rdfs:label "c2min" ;
    schema1:name "c2min" ;
    rdfs:comment "Minimum latitude of the footprint." ;
    pdssp:adqlName "c2min" ;
    pdssp:datatype "double" ;
    pdssp:fromStacConverter pdssp:Converter_geometry_lat_min ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_geometry ;
    pdssp:ucd "pos.bodyrc.lat;stat.min" ;
    pdssp:unit "deg" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#coverage> a pdssp:EpnTapColumn ;
    rdfs:label "coverage" ;
    schema1:name "coverage" ;
    rdfs:comment "href of a MOC/HEALPix coverage asset (PDSSP convention), when present." ;
    pdssp:adqlName "coverage" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:fromStacConverter pdssp:Converter_moc_healpix_asset_url ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_assets ;
    pdssp:ucd "pos.outline;obs.field" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#creation_date> a pdssp:EpnTapColumn ;
    rdfs:label "creation_date" ;
    schema1:name "creation_date" ;
    pdssp:adqlName "creation_date" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:mappedFrom pdssp:StacProperty_properties_created ;
    pdssp:ucd "time.creation" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#dataproduct_type> a pdssp:EpnTapColumn ;
    rdfs:label "dataproduct_type" ;
    schema1:name "dataproduct_type" ;
    pdssp:adqlName "dataproduct_type" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:mappedFrom pdssp:StacProperty_properties_product_type ;
    pdssp:ucd "meta.code.class" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#external_link> a pdssp:EpnTapColumn ;
    rdfs:label "external_link" ;
    schema1:name "external_link" ;
    rdfs:comment "href of the asset whose roles include \"metadata\"." ;
    pdssp:adqlName "external_link" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:fromStacConverter pdssp:Converter_metadata_asset_href ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_assets ;
    pdssp:ucd "meta.ref.url" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#filter> a pdssp:EpnTapColumn ;
    rdfs:label "filter" ;
    schema1:name "filter" ;
    rdfs:comment "Name of the first entry of properties.bands, if present." ;
    pdssp:adqlName "filter" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:fromStacConverter pdssp:Converter_first_band_name ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_bands ;
    pdssp:ucd "meta.id;instr.filter" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#granule_gid> a pdssp:EpnTapColumn ;
    rdfs:label "granule_gid" ;
    schema1:name "granule_gid" ;
    rdfs:comment "STAC collection id (this item's granule group)." ;
    pdssp:adqlName "granule_gid" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory true ;
    pdssp:mappedFrom pdssp:StacProperty_collection ;
