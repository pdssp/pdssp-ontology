    rdfs:label "phase_min" ;
    schema1:name "phase_min" ;
    rdfs:comment "Phase angle (single value in this catalog, reused for min and max)." ;
    pdssp:adqlName "phase_min" ;
    pdssp:datatype "double" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_view_phase_angle ;
    pdssp:ucd "pos.phaseAng;stat.min" ;
