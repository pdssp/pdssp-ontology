    rdfs:comment "URL of the data file."@en ;
    rdfs:range xsd:string ;
    pdssp:omsConcept sosa:hasResult ;
    pdssp:epnMandatory false ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:access_format a rdf:Property ;
    rdfs:label "access_format" ;
    rdfs:comment "Media type of the data file."@en ;
    rdfs:range xsd:string ;
    pdssp:omsConcept sosa:hasResult ;
    pdssp:epnMandatory false ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:thumbnail_url a rdf:Property ;
