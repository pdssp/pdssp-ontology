    pdssp:mappedFrom pdssp:StacProperty_providers_role_producer_name ;
    pdssp:ucd "meta.note" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#producer_name> a pdssp:EpnTapColumn ;
    rdfs:label "producer_name" ;
    schema1:name "producer_name" ;
    rdfs:comment "Name of the collection's \"producer\" provider, when declared." ;
    pdssp:adqlName "producer_name" ;
    pdssp:arraysize "*" ;
    pdssp:collectionScoped true ;
