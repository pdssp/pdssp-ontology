    rdfs:range xsd:integer ;
    pdssp:omsConcept sosa:usedProcedure ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:creation_date a rdf:Property ;
