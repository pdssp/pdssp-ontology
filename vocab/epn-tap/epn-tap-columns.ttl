    rdfs:range xsd:string ;
    pdssp:omsConcept sosa-oms:madeOnPlatform ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:instrument_name a rdf:Property ;
    rdfs:label "instrument_name" ;
    rdfs:comment "Standard name of the instrument."@en ;
    rdfs:range xsd:string ;
    pdssp:omsConcept sosa:madeBySensor ;
    pdssp:epnMandatory true ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:measurement_type a rdf:Property ;
