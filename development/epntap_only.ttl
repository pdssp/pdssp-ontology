<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#instrument_name> a pdssp:EpnTapColumn ;
    rdfs:label "instrument_name" ;
    schema1:name "instrument_name" ;
    rdfs:comment "Instrument (instruments is a list; first entry is used)." ;
    pdssp:adqlName "instrument_name" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:fromStacConverter pdssp:Converter_first_of_list ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_instruments ;
    pdssp:ucd "meta.id;instr" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#map_scale> a pdssp:EpnTapColumn ;
    rdfs:label "map_scale" ;
    schema1:name "map_scale" ;
    pdssp:adqlName "map_scale" ;
    pdssp:datatype "double" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_pdssp_map_scale ;
    pdssp:ucd "pos.wcs.scale" .

<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#measurement_type> a pdssp:EpnTapColumn ;
    rdfs:label "measurement_type" ;
    schema1:name "measurement_type" ;
    pdssp:adqlName "measurement_type" ;
    pdssp:arraysize "*" ;
    pdssp:datatype "char" ;
    pdssp:mandatory false ;
    pdssp:mappedFrom pdssp:StacProperty_properties_pdssp_measurement_type ;
    pdssp:ucd "meta.code" .

