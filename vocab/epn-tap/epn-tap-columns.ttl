    rdfs:range xsd:double ;
    pdssp:unit "deg" ;
    pdssp:omsConcept sosa-oms:parameter ;
    pdssp:epnMandatory false ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .

epn:solar_longitude_max a rdf:Property ;
    rdfs:label "solar_longitude_max" ;
    rdfs:range xsd:double ;
    pdssp:unit "deg" ;
    pdssp:omsConcept sosa-oms:parameter ;
    pdssp:epnMandatory false ;
    rdfs:isDefinedBy <https://www.ivoa.net/documents/EPNTAP/> .
