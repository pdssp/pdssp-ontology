<https://w3id.org/pdssp/stac-epntap/epntap/vocabulary#producer_institute> a pdssp:EpnTapColumn ;
    rdfs:label "producer_institute" ;
    schema1:name "producer_institute" ;
    rdfs:comment "Same source as producer_name (STAC has no separate institute field)." ;
    pdssp:adqlName "producer_institute" ;
    pdssp:arraysize "*" ;
